# ------------------------------------------------------------------
# .env.example — template for local environment variables
# ------------------------------------------------------------------
# 1. Copy this file to ".env" in the repository root.
# 2. Fill in your own values in ".env" (never in this file).
# 3. ".env" is git-ignored and must NEVER be committed or shared.
#
# This file lists variable NAMES only. Do not put real values here.
# ------------------------------------------------------------------

# MongoDB Atlas connection string (from the Atlas "Connect" dialog).
MONGODB_URI=

# Database name inside the Atlas cluster.
MONGODB_DATABASE=meme_detection_db

# Hugging Face access token (only needed for gated/private models or
# for deployment to Hugging Face Spaces).
HF_TOKEN=

# Folder for large model checkpoints (transformers), outside the repo/OneDrive.
# Leave empty to use models/text inside the repository.
NLP_CLD_MODEL_DIR=
